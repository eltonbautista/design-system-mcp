{
  "name": "@eltonbautista/mcp",
  "version": "0.1.1",
  "description": "MCP server that teaches AI coding assistants the Cabinet Vue components and tokens.",
  "type": "module",
  "bin": {
    "cabinet-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./registry.json": "./dist/registry.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2"
  },
  "license": "MIT",
  "author": "Elton Bautista",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "vue",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eltonbautista/design-system-mcp.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
