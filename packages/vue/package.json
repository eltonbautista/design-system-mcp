{
  "name": "@eltonbautista/vue",
  "version": "0.1.1",
  "description": "Cabinet: a playful, accessible Vue 3 component library.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./docs-utils": {
      "types": "./dist/docs-utils.d.ts",
      "default": "./dist/docs-utils.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@eltonbautista/tokens": "workspace:*",
    "@storybook/vue3-vite": "^10.6.9",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/browser-playwright": "^5.1.2",
    "axe-core": "^4.14.1",
    "playwright": "^1.65.1",
    "storybook": "^10.6.9",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "vitest-browser-vue": "^3.1.0",
    "vue": "^3.5.46",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "@eltonbautista/tokens": "workspace:^",
    "vue": "^3.5.0"
  },
  "license": "MIT",
  "author": "Elton Bautista",
  "keywords": [
    "vue",
    "vue3",
    "components",
    "accessibility",
    "a11y",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eltonbautista/design-system-mcp.git",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
